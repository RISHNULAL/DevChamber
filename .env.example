# Client Environment Variables (Exposed to Vite Browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SERVER_URL=http://localhost:3001
VITE_CODE_RUNNER_URL=http://localhost:3001/api/code/run

# Server-Only Environment Variables (NEVER expose to browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SERVER_PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# AI Learning Assistant (OpenAI-compatible endpoint)
AI_API_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Container Isolation (auto-detects Docker, falls back to hardened isolated subprocess)
CONTAINER_RUNTIME=docker
